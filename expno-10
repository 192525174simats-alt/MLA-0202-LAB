import numpy as np
from sklearn.mixture import GaussianMixture

X = np.array([
    [1], [1.2], [1.4], [1.6],
    [5], [5.2], [5.4], [5.6]
])

model = GaussianMixture(
    n_components=2,
    random_state=42
)

model.fit(X)

labels = model.predict(X)

print("Cluster Labels:")
print(labels)

print("Cluster Means:")
print(model.means_)
