import pandas as pd
from sklearn.linear_model import LinearRegression

data = {
    'Age': [1, 2, 3, 4, 5, 6],
    'KM': [10000, 20000, 30000, 40000, 50000, 60000],
    'Price': [900000, 800000, 700000, 600000, 500000, 400000]
}

df = pd.DataFrame(data)

X = df[['Age', 'KM']]
y = df['Price']

model = LinearRegression()

model.fit(X, y)

sample = pd.DataFrame(
    [[2, 25000]],
    columns=['Age', 'KM']
)

prediction = model.predict(sample)

print("Predicted Car Price:")
print(prediction[0])
